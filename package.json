{
  "name": "legacy-vault",
  "version": "1.0.0",
  "description": "A dead man's switch on BOT Chain — lock BOT and a final letter for a beneficiary; if you stop checking in, they inherit it.",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js --network botchainTestnet",
    "local:node": "hardhat node",
