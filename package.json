    "local:deploy": "hardhat run scripts/deploy-local.js --network localhost",
    "local:jump": "hardhat run scripts/jump-time.js --network localhost"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  }
}
